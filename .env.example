TPO_USERNAME=your_email@vit.edu
TPO_PASSWORD=your_password

# Email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_email@gmail.com

# Scheduled checking configuration (Asia/Kolkata timezone)
# Times in 24-hour HH:MM format, comma-separated (e.g., 10:00 = 10 AM, 17:00 = 5 PM, 00:00 = midnight)
CHECK_TIMES=10:00,17:00,00:00
TIMEZONE=Asia/Kolkata
TARGET_PROGRAMS=BTech-Computer Engineering,BTech-Information Technology

# Optional Telegram configuration
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Set to INFO or DEBUG
LOG_LEVEL=INFO
